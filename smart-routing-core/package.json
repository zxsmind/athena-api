    "test": "node ../../scripts/run-node-tests.mjs --heap 256 --timeout-ms 20000 --max-rss-mb 512"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
