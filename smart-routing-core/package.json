{
  "name": "@mindbox/smart-routing-core",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-dist.mjs packages/smart-routing-core/dist",
