# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# The web console is built by web/ into the server's static directory; both
# the workspace's node_modules and the built bundle are build output.
web/node_modules
server/src/public

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime data lives outside the checkout by default (platform data directory,
# or ATHENA_DATA_DIR). These entries only matter when someone deliberately points
# ATHENA_DATA_DIR back into the tree, e.g. for a portable demo.
server/data/

# Environment files
.env
.env.*
!.env.example
*.env
