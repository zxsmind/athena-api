# Server bind address and port.
HOST=0.0.0.0
PORT=39921

# Where SQLite, notebooks, and checkpoints live.
ATHENA_DATA_DIR=./server/data

# Optional: browser CORS allowlist (server.corsOrigins in config.yaml).
# Unset means CORS is disabled — a key-carrying API client needs no CORS.
# ATHENA_CORS_ORIGINS=http://localhost:5173

# Provider credentials. Keys are comma-separated; a key without a name is used alone.
GROQ_KEYS=
GEMINI_KEYS=
VERCEL_KEYS=
OPENROUTER_KEYS=
CUSTOM_KEYS=

# Search provider keys. Comma-separated for rotation.
SERPER_KEYS=
