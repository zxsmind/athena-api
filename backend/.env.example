# === PROVIDER ORDER (priority: first = tries first) ===
PROVIDER_ORDER=groq,gemini,vercel,openrouter,custom

# === GROQ ===
GROQ_API_KEYS=gsk_xxx,gsk_yyy
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# === GEMINI (OpenAI-compatible) ===
# GEMINI_API_KEYS=AIza...
# GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-pro

# === VERCEL AI GATEWAY ===
# VERCEL_GATEWAY_URL=https://xxx-ai-gateway.vercel.app/api/chat/completions
# VERCEL_GATEWAY_KEY=x
# VERCEL_MODELS=deepseek-r1,qwen-qwq-32b

# === OPENROUTER ===
# OPENROUTER_API_KEYS=sk-or-xxx
# OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o-mini

# === CUSTOM OPENAI-COMPATIBLE ===
# CUSTOM_API_KEYS=sk-xxx
# CUSTOM_URL=http://localhost:11434/v1/chat/completions
# CUSTOM_MODELS=llama3.2,llama3.1
# CUSTOM_NAME=ollama

# === SERPER (search) ===
SERPER_API_KEYS=xxx

# === THINKING STRIP (regex, comma-separated) ===
# Removes <think>, <thinking> tags from answers
# THINKING_STRIP_PATTERNS=<think>.*?</think>,<thinking>.*?</thinking>

# === GENERAL ===
HOST=0.0.0.0
PORT=8000
# MAX_SOURCES=8
# DEEP_ITERATIONS=3